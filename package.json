{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"src/**/*.{ts,tsx,js,jsx,css,json}\" \"tests/**/*.{ts,tsx}\" \"*.config.{js,mjs,ts}\" \"package.json\" \"tsconfig.json\" \".github/workflows/**/*.yml\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test tests/e2e/public-smoke.spec.ts",
    "task:contract": "python scripts/audit_tasks.py",
    "screen:contract": "python scripts/check_screen_contract.py",
    "validate": "python scripts/validate_inputs.py && npm run --silent task:contract && python scripts/build_waves.py && npm run --silent screen:contract",
    "ci": "npm run --silent lint && npm run --silent typecheck && npm run --silent test:unit && npm run --silent task:contract && npm run --silent screen:contract && npm run --silent build",
    "release:check": "npm run --silent ci && npm run --silent test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
